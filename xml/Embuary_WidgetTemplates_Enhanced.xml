		MIXED CONTENT WIDGETS (Movies + Shows combined)
		============================================ -->

	<!-- Featured: Manually curated or recently added flagship content -->
	<include name="W_TagHub_Featured_Mixed">
		<include content="WideWidget">
			<param name="id" value="$PARAM[id]"/>
			<param name="onup" value="$PARAM[onup]"/>
			<param name="ondown" value="$PARAM[ondown]"/>
			<param name="headline" value="$LOCALIZE[31279] - $LOCALIZE[31256]"/>
