<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- ============================================
		CONTINUE WATCHING - IN-PROGRESS SERIES/MOVIES
		Modern Emby-style widget with filtering
		============================================ -->

	<!-- Mixed Content Continue Watching (Movies + Shows, filtered by settings) -->
	<include name="W_ContinueWatching_Mixed">
		<include content="WideWidget">
			<param name="id" value="$PARAM[id]"/>
			<param name="onup" value="$PARAM[onup]"/>
			<param name="ondown" value="$PARAM[ondown]"/>
			<param name="headline" value="$LOCALIZE[31080]"/>
			<param name="mainlabel" value="$INFO[ListItem.Title]"/>
			<param name="sublabel" value="$INFO[ListItem.Year]"/>
			<param name="widget_target" value="videos"/>
			<param name="sortby" value="$VAR[ContinueWatchingSortMethod]"/>
			<param name="sortorder" value="descending"/>
			<param name="limit" value="$VAR[WideWidgetLimit]"/>
			<param name="content" value="plugin://script.embuary.helper/?info=getinprogress&amp;minprogress=$VAR[ContinueWatchingMinThreshold]&amp;tags=$VAR[ContinueWatchingLibraryFilter]&amp;moviesonly=$VAR[ContinueWatchingMoviesOnly]&amp;showsonly=$VAR[ContinueWatchingShowsOnly]&amp;reload=$INFO[Window(home).Property(EmbuaryWidgetUpdate)]"/>
		</include>
	</include>

	<!-- Movies Only Continue Watching -->
	<include name="W_ContinueWatching_Movies">
		<include content="WideWidget">
			<param name="id" value="$PARAM[id]"/>
			<param name="onup" value="$PARAM[onup]"/>
			<param name="ondown" value="$PARAM[ondown]"/>
			<param name="headline" value="$LOCALIZE[31080] - $LOCALIZE[342]"/>
			<param name="mainlabel" value="$INFO[ListItem.Title]"/>
			<param name="sublabel" value="$INFO[ListItem.Year]"/>
			<param name="widget_target" value="videos"/>
			<param name="sortby" value="$VAR[ContinueWatchingSortMethod]"/>
			<param name="sortorder" value="descending"/>
			<param name="limit" value="$VAR[WideWidgetLimit]"/>
			<param name="content" value="plugin://script.embuary.helper/?info=getinprogress&amp;type=movie&amp;minprogress=$VAR[ContinueWatchingMinThreshold]&amp;tags=$VAR[ContinueWatchingLibraryFilter]&amp;reload=$INFO[Window(home).Property(EmbuaryWidgetUpdate)]"/>
		</include>
	</include>

	<!-- TV Shows Only Continue Watching (In-Progress Series/Shows) -->
	<include name="W_ContinueWatching_TVShows">
		<include content="WideWidget">
			<param name="id" value="$PARAM[id]"/>
			<param name="onup" value="$PARAM[onup]"/>
			<param name="ondown" value="$PARAM[ondown]"/>
			<param name="headline" value="$LOCALIZE[31080] - $LOCALIZE[20343]"/>
			<param name="mainlabel" value="$INFO[ListItem.Title]"/>
			<param name="sublabel" value="$VAR[ContinueWatchingShowsSubtitle]"/>
			<param name="widget_target" value="videos"/>
			<param name="sortby" value="$VAR[ContinueWatchingSortMethod]"/>
			<param name="sortorder" value="descending"/>
			<param name="limit" value="$VAR[WideWidgetLimit]"/>
			<param name="content" value="plugin://script.embuary.helper/?info=getinprogress&amp;type=tvshow&amp;minprogress=$VAR[ContinueWatchingMinThreshold]&amp;tags=$VAR[ContinueWatchingLibraryFilter]&amp;reload=$INFO[Window(home).Property(EmbuaryWidgetUpdate)]"/>
		</include>
	</include>

	<!-- Continue Watching - Respect Filter Settings -->
	<include name="W_ContinueWatching_Filtered">
		<visible>!Skin.HasSetting(ContinueWatchingDisabled)</visible>
		<definition>
			<!-- Show appropriate widget based on user settings -->
			<include condition="Skin.HasSetting(ContinueWatchingShowMovies) + !Skin.HasSetting(ContinueWatchingShowTVShows)" content="W_ContinueWatching_Movies">
				<param name="id" value="$PARAM[id]"/>
				<param name="onup" value="$PARAM[onup]"/>
				<param name="ondown" value="$PARAM[ondown]"/>
			</include>
			<include condition="!Skin.HasSetting(ContinueWatchingShowMovies) + Skin.HasSetting(ContinueWatchingShowTVShows)" content="W_ContinueWatching_TVShows">
				<param name="id" value="$PARAM[id]"/>
				<param name="onup" value="$PARAM[onup]"/>
				<param name="ondown" value="$PARAM[ondown]"/>
			</include>
			<include condition="Skin.HasSetting(ContinueWatchingShowMovies) + Skin.HasSetting(ContinueWatchingShowTVShows)" content="W_ContinueWatching_Mixed">
				<param name="id" value="$PARAM[id]"/>
				<param name="onup" value="$PARAM[onup]"/>
				<param name="ondown" value="$PARAM[ondown]"/>
			</include>
		</definition>
	</include>

</includes>