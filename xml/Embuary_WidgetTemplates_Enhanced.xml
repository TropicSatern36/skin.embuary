			<param name="sublabel" value="$VAR[MediaSublabel]"/>
			<param name="widget_target" value="videos"/>
			<param name="limit" value="$VAR[WideWidgetLimit]"/>
			<param name="sortby" value="dateadded"/>
			<param name="sortorder" value="descending"/>
			<param name="content" value="plugin://script.embuary.helper/?info=getinprogress&amp;tag='$ESCINFO[Window(home).Property(library.tags.$PARAM[nr].title)]'&amp;reload=$INFO[Window(home).Property(EmbuaryWidgetUpdate)]"/>
		</include>
	</include>

