<?xml version="1.0" encoding="UTF-8"?>
<!-- Modern Player OSD Component -->
<includes>

	<!-- Playback Control Bar (appears at bottom during playback) -->
	<include name="PlayerOSD.ControlBar">
		<control type="group">
			<posx>0</posx>
			<posy>1050</posy>
			<width>1920</width>
			<height>30</height>
			<visible>Player.HasMedia + !Player.Paused</visible>

			<!-- Background bar -->
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<texture>colors/white.png</texture>
				<colordiffuse>$VAR[ColorSurface]</colordiffuse>
				<alpha>80</alpha>
			</control>

			<!-- Seek bar -->
			<control type="progress">
				<posx>0</posx>
				<posy>0</posy>
				<width>1920</width>
				<height>4</height>
				<texturebg>colors/white.png</texturebg>
				<textureslid>colors/white.png</textureslid>
				<colordiffuse>$VAR[ColorProgress]</colordiffuse>
				<info>Player.Progress</info>
			</control>

			<!-- Time info -->
			<control type="label">
				<posx>20</posx>
				<posy>8</posy>
				<width>100</width>
				<height>20</height>
				<label>$INFO[Player.Time]</label>
				<textcolor>$VAR[ColorTextPrimary]</textcolor>
				<font>font12</font>
			</control>

			<!-- Duration -->
			<control type="label">
				<posx>1800</posx>
				<posy>8</posy>
				<width>100</width>
				<height>20</height>
				<label>-$INFO[Player.Duration]</label>
				<textcolor>$VAR[ColorTextSecondary]</textcolor>
				<font>font12</font>
				<align>right</align>
			</control>

		</control>
	</include>

	<!-- Info Display (title, episode, etc) -->
	<include name="PlayerOSD.InfoDisplay">
		<control type="group">
			<posx>60</posx>
			<posy>900</posy>
			<width>1800</width>
			<height>120</height>
			<visible>Player.HasMedia</visible>

			<!-- Title -->
			<control type="label">
				<posy>0</posy>
				<width>100%</width>
				<height>auto</height>
				<label>$INFO[VideoPlayer.Title]</label>
				<textcolor>$VAR[ColorTextPrimary]</textcolor>
				<font>font36</font>
			</control>

			<!-- Episode info (if applicable) -->
			<control type="label">
				<posy>50</posy>
				<width>100%</width>
				<height>auto</height>
				<label>$INFO[VideoPlayer.Season]x$INFO[VideoPlayer.Episode] • $INFO[VideoPlayer.EpisodeName]</label>
				<textcolor>$VAR[ColorTextSecondary]</textcolor>
				<font>font18</font>
				<visible>!String.IsEmpty(VideoPlayer.EpisodeName)</visible>
			</control>

		</control>
	</include>

</includes>