<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- ============================================
		EMBUA RY TAG HUB ENHANCED - EMBY LIBRARY PATTERNS
		=============================================
		Tag-based widgets organized like Emby Android/TV:
		- Featured (manual or auto-selected by helper)
		- In Progress (continue watching)
		- Next Up (next episode)
		- Recently Added (new content)
		- Trending (by rating/play count)
		- By Genre
		- Curated selections (year, rating, etc.)
		
		Each tag can have its own hub with context menus.
		============================================ -->

	<!-- MIXED CONTENT HUB -->
	<include name="TagHub_MixedMenu">
		<!-- All content for this tag -->
		<item>
			<label>$LOCALIZE[31100]</label>
			<onclick>ActivateWindow(videos,videodb://movies/tags/$INFO[Window(home).Property(library.tags.$PARAM[nr].id)]/?force_root=$INFO[System.Time(mm)]$INFO[System.Time(ss)],return)</onclick>
		</item>
		<!-- All movies -->
		<item>
			<label>$LOCALIZE[342]</label>
			<onclick>ActivateWindow(videos,videodb://movies/tags/$INFO[Window(home).Property(library.tags.$PARAM[nr].id)]/?force_root=$INFO[System.Time(mm)]$INFO[System.Time(ss)],return)</onclick>
		</item>
		<!-- All shows -->
		<item>
			<label>$LOCALIZE[20343]</label>
			<onclick>ActivateWindow(videos,videodb://tvshows/tags/$INFO[Window(home).Property(library.tags.$PARAM[nr].id)]/?force_root=$INFO[System.Time(mm)]$INFO[System.Time(ss)],return)</onclick>
		</item>
		<!-- Collections/Sets -->
		<item>
			<label>$LOCALIZE[31169]</label>
			<onclick>ActivateWindow(videos,&quot;videodb://movies/sets/?xsp=%7b%22group%22%3a%7b%22mixed%22%3afalse%2c%22type%22%3a%22sets%22%7d%2c%22rules%22%3a%7b%22and%22%3a%5b%7b%22field%22%3a%22tag%22%2c%22operator%22%3a%22is%22%2c%22value%22%3a%5b%22$INFO[Window(home).Property(library.tags.$PARAM[nr].title)]%22%5d%7d%5d%7d%7d&quot;,return)</onclick>
			<visible>Integer.IsGreater(Container(197).NumItems,0)</visible>
		</item>
		<!-- Browse by Genre -->
		<item>
			<label>$LOCALIZE[135]</label>
			<include>ForceReloadAction</include>
			<onclick>SetProperty(ListGenres,plugin://script.embuary.helper/?info=getgenre&amp;tag=$INFO[Window(home).Property(library.tags.$PARAM[nr].title)],home)</onclick>
			<onclick>ActivateWindow(1114)</onclick>
		</item>
	</include>

	<include name="TagHubMixedTemplate">
		<!-- Hidden containers for context -->
		<control type="list" id="197">
			<include>HiddenObject</include>
			<content limit="1">videodb://movies/sets/?xsp=%7b%22group%22%3a%7b%22mixed%22%3afalse%2c%22type%22%3a%22sets%22%7d%2c%22rules%22%3a%7b%22and%22%3a%5b%7b%22field%22%3a%22tag%22%2c%22operator%22%3a%22is%22%2c%22value%22%3a%5b%22$INFO[Window(home).Property(library.tags.$PARAM[nr].title)]%22%5d%7d%5d%7d%7d/</content>
		</control>

		<!-- Main hub container -->
		<control type="grouplist" id="10">
			<include>Window_OpenClose</include>
			<defaultcontrol>10000</defaultcontrol>
			<width>100%</width>
			<height>100%</height>
			<itemgap>-80</itemgap>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<include>ScrollTime</include>
			<pagecontrol>17</pagecontrol>
			<ondown>noop</ondown>

			<!-- Spacer -->
			<include content="WidgetSpacer">
				<param name="id" value="101"/>
			</include>

			<!-- Context menu -->
			<include content="WidgetSmallMenu">
				<param name="id" value="100"/>
				<param name="onup" value="6666"/>
				<param name="ondown" value="200"/>
				<param name="headline" value="$INFO[Window(home).Property(library.tags.$PARAM[nr].title)] - $LOCALIZE[31100]"/>
				<param name="content" value="TagHub_MixedMenu"/>
				<param name="nr" value="$PARAM[nr]"/>
			</include>

			<!-- Widgets -->
			<include content="WidgetCallTemplate">
				<param name="type" value="WidgetCallTagMixed"/>
				<param name="nr" value="$PARAM[nr]"/>
			</include>
		</control>

		<!-- Header bar -->
		<include content="HeaderBar">
			<param name="id">10</param>
		</include>

		<!-- Side panel -->
		<include content="SidePanel"/>
	</include>


